{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": ["lib/", "node_modules/", ".eslintrc.json"],
  "rules": {
    "quotes": ["error", "double", { "avoidEscape": true }],
    "semi": ["error", "always"],
    "@typescript-eslint/no-explicit-any": "off"
  }
}
